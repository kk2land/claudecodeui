<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="voice_background">#F4F6FB</color>
    <color name="voice_ink">#192638</color>
    <color name="voice_secondary">#495970</color>
    <color name="voice_blue">#2451CB</color>
    <color name="voice_wave_background">#E4EDFF</color>
    <color name="voice_mic_background">#DEE8FC</color>
    <color name="voice_mic_disabled">#E3E7EF</color>
    <color name="voice_end_background">#AB263C</color>

    <style name="Widget.CloudCLI.Voice.Button" parent="">
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/voice_action_text</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Widget.CloudCLI.Voice.CallButton" parent="Widget.CloudCLI.Voice.Button">
        <item name="android:background">@drawable/voice_call_button</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:minHeight">68dp</item>
        <item name="android:paddingVertical">10dp</item>
    </style>
</resources>
