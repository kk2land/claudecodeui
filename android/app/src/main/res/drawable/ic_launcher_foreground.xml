<?xml version="1.0" encoding="utf-8"?>
<!--
  CloudCLI mark, read-only from public/icons/icon-512x512.svg (same geometry: message-square
  outline, 32/512 stroke). 512 viewport on a 108dp adaptive foreground.
  The launcher shows 72dp of the 108dp layer, so the raw 288x320-unit artwork rendered at 84%/94%
  of the visible tile and read as oversized next to the Chrome-installed PWA (whose icon shows the
  glyph at ~64%/71% of the tile, ~18% side and ~14% vertical whitespace). The group scales the
  unchanged 512-unit geometry by 0.757 about the artwork centre (256,256): 218x242 units ->
  63.9% x 70.9% of the visible 72dp layer, 13.0dp side and 10.5dp vertical whitespace, matching the
  PWA reference. Scaling the whole group keeps the 32-unit stroke proportional (same stroke/tile
  ratio as the PWA icon) instead of editing path coordinates.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">
    <group
        android:pivotX="256"
        android:pivotY="256"
        android:scaleX="0.757"
        android:scaleY="0.757">
        <path
            android:fillColor="#00000000"
            android:pathData="M128,144C128,126.327 142.327,112 160,112H352C369.673,112 384,126.327 384,144V272C384,289.673 369.673,304 352,304H224L128,400V144Z"
            android:strokeColor="#FFFFFFFF"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="32" />
    </group>
</vector>
