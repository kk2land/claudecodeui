# CloudCLI UI Environment Configuration
# Only includes variables that are actually used in the code
#
# TIP: Run 'cloudcli status' to see where this file should be located
#      and to view your current configuration.
#
# Available CLI commands:
#   claude-code-ui    - Start the server (default)
#   cloudcli start    - Start the server
#   cloudcli status   - Show configuration and data locations
#   cloudcli help     - Show help information
#   cloudcli version  - Show version information

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Backend server port (Express API + WebSocket server)
#API server
SERVER_PORT=3001
#Frontend port
VITE_PORT=5173

# Host/IP to bind servers to (default: 0.0.0.0 for all interfaces)
# Use 127.0.0.1 to restrict to localhost only
HOST=0.0.0.0

# Hide entire providers (built-in and custom models) from the new-chat model picker.
# Comma-separated IDs: claude,codex,cursor,opencode. Empty shows all.
# Restart the backend and reload the browser after changing this setting.
# CLOUDCLI_HIDDEN_PROVIDERS=cursor,opencode

# Uncomment the following line if you have a custom claude cli path other than the default "claude"
# CLAUDE_CLI_PATH=claude

# Enable Codex Goal controls and autonomous goal continuation (default: false).
# Set exactly true, then restart the backend and reload the browser.
CLOUDCLI_CODEX_GOAL_ENABLED=false

# Show the Codex account quota card (weekly and, when reported, 5-hour remaining
# quota) in Settings -> Agents -> Codex -> Account (default: false).
# Set exactly true, then restart the backend and reload the browser. While off,
# no quota RPC is sent and no quota frame is broadcast. Opening the card reads
# only the cached snapshot; the Refresh button reads quota from the app-server.
CLOUDCLI_CODEX_RATE_LIMITS_ENABLED=false

# Make the bundled project scheduler available in the plugin list (default: false).
# Set exactly true, then restart the backend and reload the browser.
CLOUDCLI_ENABLE_PROJECT_SCHEDULER=false

# Plugin scope for this instance (default: normal user scope).
# Only the exact value "super" keeps every installed plugin and third-party
# install, update and uninstall available. Unset or any other value exposes just
# the bundled project-scheduler and worker plugins; both stay toggleable.
# CLOUDCLI_ROLE=super

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Path to the authentication database file
# This is where user credentials, API keys, and tokens are stored.
#
# To use a custom location:
# DATABASE_PATH=/path/to/your/custom/auth.db
#
# Claude Code context window size (maximum tokens per session). Fallback only:
# a Claude session uses the window the SDK reports for its model once a turn completes.
VITE_CONTEXT_WINDOW=160000
CONTEXT_WINDOW=160000



# DeepSeek Harness (`dsh`): the CloudCLI app provider was removed, so
# CLOUDCLI_DSH_RUNTIME/TIMEOUT_MS/IDLE_MS/AUTH_ENV are no longer read and CloudCLI
# itself reads no DSH credential variable.
#
# Read by the bundled Worker plugin: none of the CLOUDCLI_DSH_* variables below; it
# resolves `dsh`/`pi` from PATH and reads DSH_HOME. Its DSH model picker lists
# `${DSH_HOME}/profiles/headless/cordis.patch.yml`, so DSH_HOME also decides the
# selectable models. Pi/Codex homes stay in PI_CODING_AGENT_DIR / CODEX_HOME.
# Read by the project-scheduler plugin's own `dsh` runs: CLOUDCLI_DSH_BIN,
# DSH_HOME, CLOUDCLI_DSH_PATCHES, CLOUDCLI_DSH_SESSIONS_DIR.
# The `dsh` CLI reads the credential env names its own profile patch declares
# (for example `apiKeyEnv`), inherited from this process environment.
# CLOUDCLI_DSH_BIN=/absolute/path/to/dsh                      # scheduler only
# DSH_HOME=/absolute/path/to/.dsh                             # Worker + scheduler
# CLOUDCLI_DSH_PATCHES=["/absolute/path/to/extra.patch.yml"]  # scheduler only
# CLOUDCLI_DSH_SESSIONS_DIR=/absolute/path/to/.dsh/sessions   # scheduler only
